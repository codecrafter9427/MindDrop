     72x72 safe zone (18..90) so no launcher mask can clip it. Also serves as
     the monochrome layer, hence solid white with no gradient. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Tip at (54,30), rounding out to a circle of radius 15 centred at (54,60). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,30 C46,42 39,52 39,60 C39,68.3 45.7,75 54,75 C62.3,75 69,68.3 69,60 C69,52 62,42 54,30 Z" />
    <!-- Offset highlight, suggesting a reflection on the drop's surface. -->
    <path
        android:fillColor="#59000000"
        android:pathData="M48,58 C48,54.7 50.7,52 54,52 C57.3,52 60,54.7 60,58 C60,61.3 57.3,64 54,64 C50.7,64 48,61.3 48,58 Z" />
</vector>
